# Optional comma-separated origins beyond localhost development URLs.
# The production dashboard is served by FastAPI on the same origin.
HIVE_CORS_ORIGINS=http://hive-factory.local:8000

# Optional external location for the key-only remote deployment identity.
# Default on Windows central: C:\HIVE-OS\data\ssh\id_ed25519
# HIVE_SSH_IDENTITY_FILE=D:\Protected\hive-deploy-ed25519
